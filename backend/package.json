{
  "name": "tovo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:flow": "vitest run tests/flow",
    "test:db": "vitest run tests/rls tests/flow tests/http",
    "test:http": "vitest run tests/http",
    "migrate:dry": "tsx --env-file=.env scripts/etl/load.ts",
    "migrate:apply": "tsx --env-file=.env scripts/etl/load.ts",
    "migrate:index": "tsx --env-file=.env scripts/etl/indexAll.ts",
    "migrate:verify": "tsx --env-file=.env scripts/etl/verify.ts",
    "otp:test": "tsx --env-file=.env scripts/sendTestOtp.ts",
    "hook:test": "tsx --env-file=.env scripts/testAuthHook.ts",
    "banc:jev": "tsx --env-file=.env scripts/jev/banc.ts",
    "staging:sql": "tsx scripts/scenarios/assembler.ts",
    "staging:semer": "tsx --env-file=.env.staging scripts/scenarios/semer.ts",
    "dev:staging": "tsx watch --env-file=.env.staging src/index.ts",
    "scenarios": "tsx --env-file=.env.staging scripts/scenarios/lancer.ts",
    "corpus:generer": "tsx --env-file=.env scripts/corpus/generer.ts",
    "recherche:generer": "tsx --env-file=.env scripts/recherche/generer.ts",
    "recherche:banc": "tsx --env-file=.env scripts/recherche/banc.ts",
    "recherche:variantes": "tsx --env-file=.env scripts/recherche/variantes.ts",
    "staging:nettoyer": "tsx --env-file=.env.staging scripts/scenarios/nettoyer.ts"
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.45.0",
    "bullmq": "^6.0.5",
    "fastify": "^4.28.0",
    "firebase-admin": "^14.2.0",
    "ioredis": "^6.0.0",
    "standardwebhooks": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-pgvector": "^0.0.9",
    "@types/node": "^20.14.0",
    "pino-pretty": "^11.2.0",
    "sharp": "^0.35.4",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
