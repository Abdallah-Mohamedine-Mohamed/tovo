# ---------------------------------------------------------------------
# Tovo backend — variables d'environnement
# Copier en .env et renseigner. Ne jamais commiter .env.
# ---------------------------------------------------------------------

NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Supabase --------------------------------------------------------
# Dashboard → Project Settings → API Keys → onglet
# « Publishable and secret API keys » (et non l'onglet Legacy).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé « Publishable » (sb_publishable_...). Client public : la RLS s'applique.
SUPABASE_ANON_KEY=

# Clé « Secret » (sb_secret_...). Contourne intégralement la RLS.
# Réservée aux jobs sans utilisateur : dispatch, embeddings, ETL, hook auth.
# JAMAIS pour exécuter un outil IA — la RLS ne protégerait plus rien.
# Ne sort jamais du serveur : ni dans Flutter, ni dans l'admin, ni dans un log.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hook auth Supabase ---------------------------------------------
# Secret du Send SMS Hook, format « v1,whsec_… », copié depuis
# Authentication → Hooks dans le dashboard.
AUTH_HOOK_SECRET=

# --- Livraison de l'OTP ---------------------------------------------
# whatsapp | log   (log = affiche le code en console, développement seul)
OTP_CHANNEL=log

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=tovo_otp
WHATSAPP_TEMPLATE_LOCALE=fr
WHATSAPP_GRAPH_VERSION=v21.0

# --- IA ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite

# --- Infra ------------------------------------------------------------
# Laisser VIDE en local : sans Redis joignable, le dispatch s'exécute en
# direct. Railway injecte cette variable automatiquement quand un service
# Redis est ajouté au projet.
REDIS_URL=
FCM_SERVICE_ACCOUNT_JSON=

# Remontée d'erreurs. Sans DSN, le backend fonctionne mais ne signale rien —
# acceptable en développement, aveugle en production.
SENTRY_DSN=

# --- Paiement ---------------------------------------------------------
NITA_BASE_URL=
NITA_API_KEY=
NITA_WEBHOOK_SECRET=

# Jev (TypeSafe) via OpenRouter — mode ombre : décision journalisée, jamais utilisée.
OPENROUTER_API_KEY=
JEV_OMBRE=0

# Le cerveau (ai/decideur.ts) : Gemini comprend chaque message et choisit la route.
# Vides = valeurs par défaut mesurées au banc (npm run banc:ia).
# AIGUILLAGE=cascade rend la main à l'ancien aiguillage (classifieur local + Jev).
AIGUILLAGE=
CERVEAU_MODELE=
CERVEAU_RELANCE_MS=
CERVEAU_RELANCE_MODELE=
CERVEAU_DELAI_MAX_MS=
CERVEAU_SECOURS_OPENAI=

# Notes vocales (services/transcription.ts) — principal : Microsoft MAI-Transcribe-2.
# Par OpenRouter (défaut, utilise OPENROUTER_API_KEY) ou directement chez Azure.
TRANSCRIPTION_MAI_VIA=openrouter
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus
# Filet : OpenAI gpt-transcribe, seulement si MAI traîne (> TRANSCRIPTION_SECOURS_MS), échoue ou rend du vide.
OPENAI_API_KEY=
TRANSCRIPTION_SECOURS_MS=1500
# Ombre : part des notes (0 à 1) aussi envoyée par OpenRouter ET Azure en arrière-plan, pour comparer les routes.
TRANSCRIPTION_OMBRE=0
