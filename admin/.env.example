# Copier en .env.local et renseigner.
# Dashboard Supabase → Project Settings → API Keys →
# onglet « Publishable and secret API keys ».
#
# Seule la clé PUBLISHABLE va ici. La clé secrète ne doit JAMAIS se trouver
# dans une application web : tout ce qui est préfixé VITE_ est compilé dans
# le bundle et lisible par n'importe quel visiteur.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
