# Copier en .env.local et renseigner.
# Dashboard Supabase → Project Settings → API Keys →
# onglet « Publishable and secret API keys ».
#
# Seule la clé PUBLISHABLE va ici. La clé secrète ne doit JAMAIS se trouver
# dans une application web : tout ce qui est préfixé VITE_ est compilé dans
# le bundle et lisible par n'importe quel visiteur.
VITE_SUPABASE_URL=https://ouwzhgoavjeqwcwkqulh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_ajTB2X3Frot-LVCmUvZYkQ_IiMCJaOY

# URL publique du backend Tovo (Railway → Settings → Networking).
# Nécessaire pour la page « Prix concurrents » : ces offres doivent être
# vectorisées, ce que seule la clé Gemini du backend permet.
VITE_API_BASE_URL=https://tovo-production.up.railway.app
